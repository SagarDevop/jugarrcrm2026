# ===================================================
# JUGARR CRM — PRODUCTION BACKEND (RENDER) ENVIRONMENT
# ===================================================

# 1. Server Environment
NODE_ENV=production
PORT=5000

# 2. Frontend Live URL (Cross-Origin CORS & Cookie Security)
# Replace with your actual Vercel domain once deployed:
CLIENT_URL=https://your-frontend-app.vercel.app

# 3. MongoDB Atlas Cluster URI
MONGODB_URI=mongodb+srv://dbmangoo71:ybGQKq4YDhuQDuCA@cluster0.z3vvxhb.mongodb.net/Jugarrcrm1?retryWrites=true&w=majority&tls=true

# 4. JWT Authentication Secrets (Generate secure random strings for production)
JWT_ACCESS_SECRET=jugarr_super_secure_access_secret_2026_prod_token
JWT_REFRESH_SECRET=jugarr_super_secure_refresh_secret_2026_prod_token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 5. Cookie Security (Set to true in production with HTTPS)
COOKIE_SECURE=true
# Leave empty or set to your custom domain if using one (e.g. .jugarr.in)
COOKIE_DOMAIN=

# 6. Feature Flags
ENABLE_VIDEO_GENERATION=false
VIDEO_API_PROVIDER=mock
