# AgencyOS Environment Variables

# Backend Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/agencyos

# JWT Secret Keys
JWT_ACCESS_SECRET=agencyos_super_secret_access_jwt_key_2026_production_grade
JWT_REFRESH_SECRET=agencyos_super_secret_refresh_jwt_key_2026_production_grade
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Storage & External Services (Optional / Feature Flagged)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=

# Brevo (Bravo) Transactional Email Service
BREVO_API_KEY=
BREVO_SENDER_EMAIL=sagar@jugarr.in
BREVO_SENDER_NAME=Jugarr Technologies

# Video Generation Feature Flag (Disabled by default until provider key is provided)
ENABLE_VIDEO_GENERATION=false
VIDEO_API_PROVIDER=mock
VIDEO_API_KEY=

# Frontend Environment (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
